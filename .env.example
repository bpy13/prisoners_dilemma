# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is made at each start (everyone is logged out on restart).
SECRET_KEY=

# 1 turns on Flask debug mode (auto-reload and the in-browser debugger). Only use it on a
# machine nobody else can reach: the debugger lets anyone who can open the page run code.
DEBUG=0

# Where the server listens. 0.0.0.0 lets other devices on your network join.
HOST=0.0.0.0
PORT=5000

# Seconds a dropped connection (page reload, network blip) may take to come back before the
# player's game is ended and the username freed.
DISCONNECT_GRACE_SECONDS=10
